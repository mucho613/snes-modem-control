PPP_FLAG_SEQUENCE = $7e
PPP_CONTROL_ESCAPE = $7d
PPP_TRANSPARENCY_XOR = $20

PPP_INITIAL_FCS16 = $ffff
PPP_GOOD_FCS16 = $f0b8
PPP_FCS16_POLYNOMIAL_REVERSED = $8408

PPP_DEFAULT_MRU = 1500
PPP_UNCOMPRESSED_HEADER_LENGTH = 4
PPP_FCS16_LENGTH = 2
PPP_MINIMUM_FRAME_WITH_FCS_LENGTH = 4
PPP_MAX_UNESCAPED_FRAME_LENGTH = PPP_UNCOMPRESSED_HEADER_LENGTH + PPP_DEFAULT_MRU + PPP_FCS16_LENGTH

PPP_DECODER_FLAG_SYNCHRONIZED = $01
PPP_DECODER_FLAG_ESCAPED = $02
PPP_DECODER_FLAG_OVERFLOWED = $04

PPP_EVENT_NONE = $00
PPP_EVENT_FRAME = $01
PPP_EVENT_FCS_ERROR = $02
PPP_EVENT_INVALID = $03
PPP_EVENT_OVERFLOW = $04

PPP_INVALID_NONE = $00
PPP_INVALID_TOO_SHORT = $01
PPP_INVALID_ESCAPE_BEFORE_FLAG = $02

PPP_RECEIVE_DRAIN_BUDGET = 32

.macro pppIncrement32 address
  .local done
  rep #$20
  .a16
  inc address
  bne done
  inc address + 2
done:
  sep #$20
  .a8
.endmacro
